#!/bin/sh
[ -n "$TMUX_PANE" ] || exit 0
state="$1"
case "$state" in
  done|error)
    seen=$(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}')
    [ "$seen" = 1 ] && state=""
    ;;
esac
if [ -n "$state" ]; then
  tmux set-option -wq -t "$TMUX_PANE" @state "$state"
else
  tmux set-option -wuq -t "$TMUX_PANE" @state
fi
if [ "$2" = ping ]; then
  tty=$(tmux display -p -t "$TMUX_PANE" '#{pane_tty}')
  printf '\a' > "$tty"
fi
